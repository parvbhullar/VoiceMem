# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
tests/

# Runtime data: memory stores, evaluation results, recording archives
results/
/rtc_gateway/supermem-rtc
memory/
out/

# Environment and local config
.env
.venv/
.claude/
.DS_Store

# Model weights: fetched by scripts/download_models.sh, not committed
*.onnx
*.ckpt
*.pt
*.pth
*.safetensors
*.bin
# Contents of models/ come from the download script or runtime cache, not committed
/models/

# Local demo forks and personal seed scripts
demo_local/
scripts/seed_*.py

# Electron desktop shell
node_modules/

# Default memory root (lands in the current directory when memory_root is not passed)
supermem_memory/
examples/example_memory/
# Memory spaces: the **directory structure** is committed, the data inside is not.
# A fresh clone gets empty folders -- demo (for running the demo) and mysupermem (your own);
# whoever runs it accumulates their own memories, nobody's memories get pushed.
# Memory Space: only empty directories are committed, **no memory content ever goes in the repo**.
# One space per language (demo-zh / demo-en) -- retrieval is vector-based, and mixing languages
# in one store makes half the memories unreachable. The demo picks the space by language on start.
supermem_memoryspace/*
!supermem_memoryspace/demo-zh/
!supermem_memoryspace/demo-en/
!supermem_memoryspace/mysupermem/
supermem_memoryspace/demo-zh/*
supermem_memoryspace/demo-en/*
supermem_memoryspace/mysupermem/*
!supermem_memoryspace/demo-zh/.gitkeep
!supermem_memoryspace/demo-en/.gitkeep
!supermem_memoryspace/mysupermem/.gitkeep
